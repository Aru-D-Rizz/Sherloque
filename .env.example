# =============================================================================
# .env.example — Sherloque Environment Variables
#
# Copy this file to .env (root) and frontend/.env.local
# NEVER commit .env or .env.local with real secrets
# =============================================================================

# ─── DEMO MODE (default: true for Vercel) ─────────────────────────────────────
# When DEMO_MODE=true the backend/frontend uses the static NFEO fixture dataset
# (INV-8391 scenario) instead of a live Fabric network.
# Set to false only when a local Fabric network is running.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ─── AI — OpenRouter ──────────────────────────────────────────────────────────
# Get a free key at https://openrouter.ai
# Used for the "Ask Sherloque" natural-language investigation panel.
# If not set, the deterministic fallback answers all questions from the evidence.
OPENROUTER_API_KEY=

# ─── Fabric Network (local only — not required for Vercel demo) ───────────────
FABRIC_VERSION=2.5.7
FABRIC_CA_VERSION=1.5.9
CHANNEL_NAME=tradechannel
CHAINCODE_NAME=asset-transfer

# Fabric Gateway connection (Phase 2 live mode)
# FABRIC_GATEWAY_HOST=localhost
# FABRIC_GATEWAY_PORT=7051
# ORG1_MSP_ID=Org1MSP
# ORG2_MSP_ID=Org2MSP
# ORG3_MSP_ID=Org3MSP
# FABRIC_TLS_CERT_PATH=./fabric/network/fabric-samples/test-network/organizations/...
# FABRIC_IDENTITY_CERT_PATH=...
# FABRIC_IDENTITY_KEY_PATH=...

# ─── Frontend ─────────────────────────────────────────────────────────────────
# For local dev with a separate backend (Phase 2 live mode)
# NEXT_PUBLIC_API_URL=http://localhost:3001
